---
import Base from '../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.trivarone.com.au/about#pradeep",
  "name": "Pradeep Anandraj",
  "jobTitle": "Founder",
  "email": "pradeep@trivarone.com",
  "url": "https://www.trivarone.com.au/about/",
  "worksFor": {
    "@id": "https://www.trivarone.com.au/#organisation"
  },
  "sameAs": [
    "https://www.linkedin.com/in/pradeepanandraj"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Brisbane",
    "addressRegion": "QLD",
    "addressCountry": "AU"
  },
  "knowsAbout": [
    "Oracle database administration",
    "Business intelligence",
    "AI discoverability",
    "Bookkeeping and accounting",
    "Content production for regulated professions"
  ],
  "description": "Founder of Trivarone. Eight years as an Oracle database administrator, followed by qualifications in bookkeeping and accounting, and now working in AI search and discoverability for doctors, dentists and allied health practitioners."
};
---
<Base
  title="About — Trivarone and Pradeep Anandraj"
  description="Trivarone was founded by Pradeep Anandraj, an Oracle database administrator of eight years now working in AI search and discoverability for healthcare."
  path="/about"
  ogDescription="Eight years in database administration, a background in bookkeeping and accounting, and a practice built around SEO and AI SEO for doctors, dentists and allied health practitioners."
  ogType="profile"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <section class="titleblock">
    <div class="shell">
      <p class="eyebrow">About</p>
      <h1>Trivarone is one person doing the work <em>properly</em>.</h1>
      <p class="standfirst">
        One person does all of the work, so there is no account manager between you and
        the person who is searching, writing and correcting.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <p class="section-label">The founder</p>
      <h2>Pradeep Anandraj</h2>
      <div class="prose">
        <p class="lede">
          My father was an anaesthetist. I grew up seeing what a doctor's working life asks
          of a person: long days, patients first, and little time left for anything else.
          That is why I work with health practices.
        </p>
        <p>
          I spent eight years as an Oracle database administrator. That work taught me that
          a business runs on how well its information is organised.
        </p>
        <p>
          I later qualified in bookkeeping and accounting, and held a mortgage broker
          licence. That put me across the desk from small business owners dealing with
          compliance and paperwork.
        </p>
        <p>
          Trivarone came out of both. Being found is an information problem before it is a
          marketing problem. A practice described one way on its listings and another way
          on its website is hard for a search engine to place and hard for an AI system to
          recommend. Fixing that is patient work, and it is the work I do.
        </p>
        <p>
          I work with doctors, dentists and allied health practitioners in private
          practice. I have no clinical knowledge and do not pretend otherwise. What I bring
          is the habit of checking which rules apply before writing, and of telling a
          practice plainly when something is not worth doing.
        </p>
      </div>

      <dl class="metagrid">
        <div>
          <dt>Background</dt>
          <dd>Eight years, Oracle database administration</dd>
        </div>
        <div>
          <dt>Also qualified in</dt>
          <dd>Bookkeeping and accounting</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>Brisbane, Australia</dd>
        </div>
        <div>
          <dt>Working with clients in</dt>
          <dd>Australia</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">How Trivarone works</p>
      <h2>Four commitments, kept on every engagement.</h2>

      <ol class="findings">
        <li class="finding">
          <span class="finding__no">01</span>
          <div class="finding__body">
            <span class="tag">The check comes before the recommendation</span>
            <p>
              Nothing is recommended before the practice has been searched. The findings
              decide the work, so there is no standard package.
            </p>
          </div>
        </li>
        <li class="finding">
          <span class="finding__no">02</span>
          <div class="finding__body">
            <span class="tag">Regulator confirmed, never assumed</span>
            <p>
              Which advertising rules apply is established before a word is written. A
              physiotherapist, a dentist and a speech pathologist answer to different
              bodies, and the rules differ. A mistake creates exposure for the practice, so
              it is checked first.
            </p>
          </div>
        </li>
        <li class="finding">
          <span class="finding__no">03</span>
          <div class="finding__body">
            <span class="tag">Observed, not asserted</span>
            <p>
              Findings state which search was run, on which system, and on what date. AI
              answers vary between sessions, so anything uncertain is written as uncertain.
            </p>
          </div>
        </li>
        <li class="finding">
          <span class="finding__no">04</span>
          <div class="finding__body">
            <span class="tag">What not to spend money on</span>
            <p>
              Every full AI search report says which findings are not worth acting on, and
              which causes cannot be bought at any price: how far you are from the person
              searching, and how long the practice has existed.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="band band--navy">
    <div class="shell">
      <p class="section-label">Next step</p>
      <h2>A conversation costs nothing and commits you to nothing.</h2>
      <div class="prose">
        <p class="lede">
          If something here matches a problem you recognise, send a short message
          describing it. If Trivarone is not the right answer, you will be told that
          plainly.
        </p>
      </div>
      <div class="actions">
        <a class="btn" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
