---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.trivarone.com.au/check#service",
  "name": "AI Search Snapshot",
  "url": "https://www.trivarone.com.au/check/",
  "serviceType": "Search and AI discoverability assessment",
  "description": "Two searches are run for a practice across Google's ordinary results, Google's AI Mode, ChatGPT and Gemini, along with where the practice appears in Google Maps. One search is for the practice name. The other is for the service the practice offers, without the name attached. The result is a short written summary showing whether the practice appears when somebody searches for what it does.",
  "provider": {
    "@id": "https://www.trivarone.com.au/#organisation"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  },
  "audience": {
    "@type": "Audience",
    "audienceType": "Medical, dental and allied health practices, and independent practitioners in private practice"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "AUD",
    "availability": "https://schema.org/InStock",
    "description": "There is no charge for the AI Search Snapshot. There is no obligation and no follow-up sales sequence."
  }
};
---
<Base
  title="AI Search Snapshot | Trivarone"
  description="The AI Search Snapshot from Trivarone: I search for your practice the way a patient would, on Google, ChatGPT and Gemini, and email you a short written answer."
  path="/check"
  ogDescription="Does your practice appear when somebody searches for what you do? I search the way a patient would and email you a short written answer."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <EnquiryForm formId="checkform" thanksForm="snapshot">
  <section class="titleblock">
    <div class="shell">
      <p class="eyebrow">AI Search Snapshot</p>
      <h1>Search your practice name. Then search <em>what you do</em>.</h1>
      <p class="standfirst">
        The AI Search Snapshot is a short written answer from Trivarone for health
        practices. I search for your practice the way a patient would, on Google,
        ChatGPT and Gemini, and tell you whether you appear. Your part takes about
        a minute.
      </p>
      <div class="actions">
        <a class="btn" href="#request">Ask for the snapshot</a>
        <a class="btn btn--ghost" href="#what-happens">See what you get</a>
      </div>
    </div>
  </section>

  <section class="band" id="what-happens">
    <div class="shell">
      <p class="section-label">What it involves</p>
      <h2>What the snapshot covers</h2>

      <div class="prose">
        <p class="lede">
          Two searches are run for your practice across Google's ordinary
          results, Google's AI Mode, ChatGPT and Gemini.
          Where you appear in Google Maps is checked alongside them.
        </p>
        <p>
          The first is for your practice name. The second is for the service you
          offer, with your name left out entirely.
        </p>
        <p>
          Almost every practice passes the first. The second is where the answer
          is, because that is the search a person makes when they need what you
          do but do not yet know who you are.
        </p>
      </div>

      <ol class="outcomes">
        <li class="outcome">
          <h3>Whether you appear at all</h3>
          <p>
            In each place checked, for your own category. Some practices
            appear in one and not the others. Some appear in none.
          </p>
        </li>
        <li class="outcome">
          <h3>Who appears instead of you</h3>
          <p>
            Named. Not a count, not a percentage — the actual practices being
            put in front of the person who was looking for what you do.
          </p>
        </li>
        <li class="outcome">
          <h3>What is most likely causing it</h3>
          <p>
            Usually two or three things, and usually not what the owner expects.
            A single setting on a business listing. Review volume against
            competitors. A site an AI system cannot read. Age.
          </p>
        </li>
        <li class="outcome">
          <h3>What is free to fix, and what is not</h3>
          <p>
            Separated plainly, so you can act on the free ones yourself without
            paying anybody, including me.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">How it works</p>
      <h2>What is asked of you</h2>

      <div class="prose">
        <p>
          Your practice name, your website, and the service you would most want
          to be found for. That is the whole intake. You can talk to me first if
          you prefer, or receive the snapshot by email.
        </p>
        <p>
          I email you the snapshot within a few days. It is written to be read once and understood, not to demonstrate
          how much work went into it.
        </p>
        <p>
          There is no obligation attached and no follow-up sequence. If the
          findings are things you can fix yourself, that is a good outcome and
          you should go and fix them.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Worth saying plainly</p>
      <h2>What this is not</h2>

      <div class="prose">
        <p>
          <strong>It is not an automated report.</strong> The searches are run by
          hand and the findings are written by a person. That is slower than a
          tool and it is the reason the findings are worth reading.
        </p>
        <p>
          <strong>It is not a score.</strong> A number out of a hundred tells you
          nothing you can act on. The snapshot tells you what is happening and what
          is causing it.
        </p>
        <p>
          <strong>It does not come with a guarantee.</strong> Nobody controls what
          Google or ChatGPT says about a business, and anyone who tells you
          otherwise is selling something. What can be controlled is whether the
          information those systems rely on is accurate, complete and readable.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Background reading</p>
      <h2>If you would rather understand it first</h2>

      <div class="prose">
        <p>
          None of this is secret, and you are welcome to do it yourself. These
          explain the parts that matter.
        </p>
      </div>

      <ul class="pieces">
        <li class="piece">
          <a href="/articles/robots-txt-ai-crawlers/">
            <span class="piece__title">Can ChatGPT read your website?</span>
            <span class="piece__note">The thirty-second check most business owners have never done.</span>
          </a>
        </li>
        <li class="piece">
          <a href="/articles/rank-for-name-not-category/">
            <span class="piece__title">Why you rank for your name but not for what you sell</span>
            <span class="piece__note">A real business, five searches, nineteen competitors, no appearances.</span>
          </a>
        </li>
        <li class="piece">
          <a href="/faq/">
            <span class="piece__title">Common questions</span>
            <span class="piece__note">What the snapshot involves, what it costs, and where the limits are.</span>
          </a>
        </li>
        <li class="piece">
          <a href="/services/">
            <span class="piece__title">What Trivarone produces</span>
            <span class="piece__note">If the snapshot finds something worth doing, this is the work that follows.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="band band--rule" id="request">
    <div class="shell">
      <p class="section-label">Ask for it</p>
      <h2>Five short answers, and that is all I need</h2>

      <div class="prose">
        <p>
          Two searches, one short written answer. There is no charge and no obligation.
        </p>
        <p>
          I do not need a questionnaire or access to any of your accounts.
        </p>
      </div>

      <p class="formcall">
        Prefer to talk? Call or text Pradeep on <a href="tel:+61469219318">+61 469 219 318</a>.
      </p>

      <form class="enquiry" id="checkform" action="https://formspree.io/f/xgawweeb" method="POST">

        <div class="field">
          <label for="cf-business">Practice name</label>
          <input type="text" id="cf-business" name="business" required autocomplete="organization"
            aria-describedby="cf-business-error" data-error="Please add your practice name.">
          <p class="fielderror" id="cf-business-error" aria-live="polite" hidden></p>
        </div>

        <div class="field">
          <label for="cf-website">Website</label>
          <input type="text" id="cf-website" name="website" required inputmode="url"
            placeholder="yourbusiness.com.au" autocomplete="url"
            aria-describedby="cf-website-error" data-error="Please add your website address. If you do not have one, write none.">
          <p class="fielderror" id="cf-website-error" aria-live="polite" hidden></p>
        </div>

        <div class="field">
          <label for="cf-service">The one service you would most want to be found for</label>
          <input type="text" id="cf-service" name="service" required autocomplete="off"
            placeholder="For example: shoulder rehabilitation, or dental implants"
            aria-describedby="cf-service-error" data-error="Please add the service you want to be found for.">
          <p class="fielderror" id="cf-service-error" aria-live="polite" hidden></p>
        </div>

        <div class="field">
          <label for="cf-suburb">Suburb or area you work in</label>
          <input type="text" id="cf-suburb" name="suburb" required autocomplete="address-level2"
            placeholder="The area a patient would search alongside the service"
            aria-describedby="cf-suburb-error" data-error="Please add the suburb or area you work in.">
          <p class="fielderror" id="cf-suburb-error" aria-live="polite" hidden></p>
        </div>

        <div class="field">
          <label for="cf-email">Email address</label>
          <input type="email" id="cf-email" name="email" required autocomplete="email"
            aria-describedby="cf-email-error" data-error="Please add your email address, so I can send you the snapshot."
            data-error-format="Please check your email address. It should look like name@yourpractice.com.au.">
          <p class="fielderror" id="cf-email-error" aria-live="polite" hidden></p>
        </div>

        <fieldset class="field choice">
          <legend>How would you like to hear back?</legend>
          <label class="choice__option">
            <input type="radio" name="how_to_hear_back" value="Email me the snapshot"
              data-reply="email" data-subject="email the snapshot" checked>
            Email me the snapshot
          </label>
          <label class="choice__option">
            <input type="radio" name="how_to_hear_back" value="Email me the snapshot, then call me to go through it"
              data-reply="email-call" data-subject="email, then call" data-call>
            Email me the snapshot, then call me to go through it
          </label>
          <label class="choice__option">
            <input type="radio" name="how_to_hear_back" value="Call me first for a short introductory call"
              data-reply="call" data-subject="call first" data-call>
            Call me first for a short introductory call
          </label>
        </fieldset>

        <div class="field">
          <label for="cf-phone">Phone <span class="optional" data-phone-note>optional</span></label>
          <input type="tel" id="cf-phone" name="phone" autocomplete="tel" inputmode="tel"
            aria-describedby="cf-phone-error" data-error="Please add a phone number so I can call you, or choose Email me the snapshot.">
          <p class="fielderror" id="cf-phone-error" aria-live="polite" hidden></p>
        </div>

        <div class="field">
          <label for="cf-name">Your name <span class="optional">optional</span></label>
          <input type="text" id="cf-name" name="name" autocomplete="name">
        </div>

        <div class="field">
          <label for="cf-note">Anything else worth knowing <span class="optional">optional</span></label>
          <textarea id="cf-note" name="note" rows="4" autocomplete="off"
            placeholder="Only if there is something specific you would like looked at."></textarea>
        </div>

        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot">
        <input type="hidden" name="_subject" value="AI Search Snapshot request via trivarone.com.au">

        <div class="actions">
          <button class="btn" type="submit">Request the snapshot</button>
        </div>

        <p class="formnote">
          There is no obligation attached and no follow-up sequence. If the findings
          are things you can fix yourself, go and fix them. Your details are handled in
          accordance with the <a href="/privacy/">privacy policy</a>.
        </p>

      </form>
    </div>
  </section>

  <section class="band band--navy">
    <div class="shell">
      <p class="section-label">Ask for it</p>
      <h2>Thirty seconds of your time. A few days of mine.</h2>
      <div class="prose">
        <p class="lede">
          Send your practice name, your website, and the one service you would
          most want to be found for. That is everything needed to begin.
        </p>
      </div>
      <div class="actions">
        <a class="btn" href="#request">Ask for the snapshot</a>
      </div>
    </div>
  </section>
  </EnquiryForm>
</Base>
