---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.trivarone.com/check#service",
  "name": "Search and AI Discoverability Check",
  "url": "https://www.trivarone.com/check",
  "serviceType": "Search and AI discoverability assessment",
  "description": "Two searches are run for a business across five places: Google, Google Maps, Google's AI Mode, ChatGPT and Perplexity. One search is for the business name. The other is for the service the business sells, without the name attached. The result is a short written summary showing whether the business appears when somebody searches for what it does.",
  "provider": {
    "@id": "https://www.trivarone.com/#organisation"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  },
  "audience": {
    "@type": "Audience",
    "audienceType": "Medical and allied health practices, NDIS providers, and small business owners in trades and services"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "AUD",
    "availability": "https://schema.org/InStock",
    "description": "The initial check is free. There is no obligation and no follow-up sales sequence."
  }
};
---
<Base
  title="The Free Discoverability Check — Trivarone"
  description="A free written check showing whether your business appears when somebody searches for what you do, rather than only when they know your name already."
  path="/check"
  ogDescription="Does your business appear when somebody searches for what you do? Two searches, five places, one short written answer. Free."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <EnquiryForm formId="checkform" successId="checksuccess">
  <section class="titleblock">
    <div class="shell">
      <p class="eyebrow">The free check</p>
      <h1>Search your business name. Then search <em>what you sell</em>.</h1>
      <p class="standfirst">
        If the first works and the second does not, you have the most common
        problem I see. This check tells you which of the two you have, in about
        thirty seconds of your time.
      </p>
      <div class="actions">
        <a class="btn" href="#request">Ask for the check</a>
        <a class="btn btn--ghost" href="#what-happens">See what you get</a>
      </div>
    </div>
  </section>

  <section class="band" id="what-happens">
    <div class="shell">
      <p class="section-label">What it involves</p>
      <h2>Two searches, five places</h2>

      <div class="prose">
        <p class="lede">
          Two searches are run for your business across five places: Google,
          Google Maps, Google's AI Mode, ChatGPT and Perplexity.
        </p>
        <p>
          The first is for your business name. The second is for the service you
          sell, with your name left out entirely.
        </p>
        <p>
          Almost every business passes the first. The second is where the answer
          is, because that is the search a person makes when they need what you
          do but do not yet know who you are.
        </p>
      </div>

      <ol class="outcomes">
        <li class="outcome">
          <h3>Whether you appear at all</h3>
          <p>
            Across all five surfaces, for your own category. Some businesses
            appear in one and not the other four. Some appear in none.
          </p>
        </li>
        <li class="outcome">
          <h3>Who appears instead of you</h3>
          <p>
            Named. Not a count, not a percentage — the actual businesses being
            put in front of the person who was looking for what you sell.
          </p>
        </li>
        <li class="outcome">
          <h3>What is most likely causing it</h3>
          <p>
            Usually two or three things, and usually not what the owner expects.
            A single setting on a business listing. Review volume against
            competitors. A site an AI system cannot read. Age.
          </p>
        </li>
        <li class="outcome">
          <h3>What is free to fix, and what is not</h3>
          <p>
            Separated plainly, so you can act on the free ones yourself without
            paying anybody, including me.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">How it works</p>
      <h2>What is asked of you</h2>

      <div class="prose">
        <p>
          Your business name, your website, and the service you would most want
          to be found for. That is the whole intake. No form of twenty questions,
          no discovery call, no access to any of your accounts.
        </p>
        <p>
          The check is returned as a short written summary, usually within a few
          days. It is written to be read once and understood, not to demonstrate
          how much work went into it.
        </p>
        <p>
          There is no obligation attached and no follow-up sequence. If the
          findings are things you can fix yourself, that is a good outcome and
          you should go and fix them.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Worth saying plainly</p>
      <h2>What this is not</h2>

      <div class="prose">
        <p>
          <strong>It is not an automated report.</strong> The searches are run by
          hand and the findings are written by a person. That is slower than a
          tool and it is the reason the findings are worth reading.
        </p>
        <p>
          <strong>It is not a score.</strong> A number out of a hundred tells you
          nothing you can act on. The check tells you what is happening and what
          is causing it.
        </p>
        <p>
          <strong>It does not come with a guarantee.</strong> Nobody controls what
          Google or ChatGPT says about a business, and anyone who tells you
          otherwise is selling something. What can be controlled is whether the
          information those systems rely on is accurate, complete and readable.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Background reading</p>
      <h2>If you would rather understand it first</h2>

      <div class="prose">
        <p>
          None of this is secret, and you are welcome to do it yourself. These
          explain the parts that matter.
        </p>
      </div>

      <ul class="pieces">
        <li class="piece">
          <a href="/articles/robots-txt-ai-crawlers">
            <span class="piece__title">Can ChatGPT read your website?</span>
            <span class="piece__note">The thirty-second check most business owners have never done.</span>
          </a>
        </li>
        <li class="piece">
          <a href="/articles/rank-for-name-not-category">
            <span class="piece__title">Why you rank for your name but not for what you sell</span>
            <span class="piece__note">A real business, five searches, nineteen competitors, no appearances.</span>
          </a>
        </li>
        <li class="piece">
          <a href="/faq">
            <span class="piece__title">Common questions</span>
            <span class="piece__note">What the check involves, what it costs, and where the limits are.</span>
          </a>
        </li>
        <li class="piece">
          <a href="/services">
            <span class="piece__title">What Trivarone produces</span>
            <span class="piece__note">If the check finds something worth doing, this is the work that follows.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="band band--rule" id="request">
    <div class="shell">
      <p class="section-label">Ask for it</p>
      <h2>Three things, and that is the whole intake</h2>

      <div class="prose">
        <p>
          No discovery call, no questionnaire, and no access to any of your
          accounts. The check is returned as a short written summary, usually
          within a few days.
        </p>
      </div>

      <div class="formsuccess" id="checksuccess" hidden>
        <p class="formsuccess__title">Request received.</p>
        <p>Thank you. The check is usually returned within a few days, by email.</p>
      </div>

      <form class="enquiry" id="checkform" action="https://formspree.io/f/xgawweeb" method="POST">

        <div class="field">
          <label for="cf-business">Business name</label>
          <input type="text" id="cf-business" name="business" required autocomplete="organization">
        </div>

        <div class="field">
          <label for="cf-website">Website</label>
          <input type="text" id="cf-website" name="website" required
            placeholder="yourbusiness.com.au" autocomplete="url">
        </div>

        <div class="field">
          <label for="cf-service">The one service you would most want to be found for</label>
          <input type="text" id="cf-service" name="service" required
            placeholder="For example: shoulder rehabilitation, or concrete pumping">
        </div>

        <div class="field">
          <label for="cf-suburb">Suburb or area you work in</label>
          <input type="text" id="cf-suburb" name="suburb" required
            placeholder="The area a customer would search alongside the service">
        </div>

        <div class="field">
          <label for="cf-email">Email address</label>
          <input type="email" id="cf-email" name="email" required autocomplete="email">
        </div>

        <div class="field">
          <label for="cf-name">Your name <span class="optional">optional</span></label>
          <input type="text" id="cf-name" name="name" autocomplete="name">
        </div>

        <div class="field">
          <label for="cf-note">Anything else worth knowing <span class="optional">optional</span></label>
          <textarea id="cf-note" name="note" rows="4"
            placeholder="Only if there is something specific you would like looked at."></textarea>
        </div>

        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot">
        <input type="hidden" name="_subject" value="Free discoverability check request via trivarone.com">

        <div class="actions">
          <button class="btn" type="submit">Request the check</button>
        </div>

        <p class="formnote">
          There is no obligation attached and no follow-up sequence. If the findings
          are things you can fix yourself, go and fix them. Your details are handled in
          accordance with the <a href="/privacy">privacy policy</a>.
        </p>

      </form>
    </div>
  </section>

  <section class="band band--navy">
    <div class="shell">
      <p class="section-label">Ask for it</p>
      <h2>Thirty seconds of your time. A few days of mine.</h2>
      <div class="prose">
        <p class="lede">
          Send your business name, your website, and the one service you would
          most want to be found for. That is everything needed to begin.
        </p>
      </div>
      <div class="actions">
        <a class="btn" href="#request">Ask for the check</a>
      </div>
    </div>
  </section>
  </EnquiryForm>
</Base>
