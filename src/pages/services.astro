---
import Base from '../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Services — Trivarone",
  "url": "https://www.trivarone.com/services",
  "isPartOf": {
    "@id": "https://www.trivarone.com/#organisation"
  },
  "about": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Service",
          "name": "Free discoverability check",
          "description": "Your practice searched two ways, by name and by what it actually does, across Google, Google Maps, ChatGPT, Gemini and Perplexity, with what came back and what is worth doing first. No cost."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Service",
          "name": "AI search and discoverability report",
          "description": "The longer version, with causes traced rather than listed, including what a practice cannot change at any price."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Service",
          "name": "Google Business Profile setup and repair",
          "description": "Categories, service areas, description and details corrected, and name, address and phone made identical everywhere they appear."
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "Service",
          "name": "Bing Places for Business setup",
          "description": "ChatGPT's web search runs on Bing's index rather than Google's. Claiming and completing the Bing listing is free and commonly missed."
        }
      },
      {
        "@type": "ListItem",
        "position": 5,
        "item": {
          "@type": "Service",
          "name": "Structured data and schema markup",
          "description": "Markup that tells a search or AI system what a page is about rather than leaving it to guess."
        }
      },
      {
        "@type": "ListItem",
        "position": 6,
        "item": {
          "@type": "Service",
          "name": "Homepage and website wording",
          "description": "Not a rebuild. What you do, where you do it, who for, and why you are credible, in plain words and before anyone has to scroll."
        }
      },
      {
        "@type": "ListItem",
        "position": 7,
        "item": {
          "@type": "Service",
          "name": "Articles that answer real questions",
          "description": "Writing that answers what people ask before they call, supplied ready to publish with structured data included."
        }
      },
      {
        "@type": "ListItem",
        "position": 8,
        "item": {
          "@type": "Service",
          "name": "Content repurposing",
          "description": "Material you already have turned into posts and captions across your channels on a fixed delivery day. Writing and repurposing only."
        }
      },
      {
        "@type": "ListItem",
        "position": 9,
        "item": {
          "@type": "Service",
          "name": "Website build",
          "description": "Occasional work, usually where a relationship already exists or the existing site is the thing standing in the way."
        }
      },
      {
        "@type": "ListItem",
        "position": 10,
        "item": {
          "@type": "Service",
          "name": "Monthly retainer",
          "description": "Listings kept current, new questions answered, and content produced on a fixed day each month, with the search re-run quarterly."
        }
      }
    ]
  }
};
---
<Base
  title="Services — AI Search for Healthcare and NDIS — Trivarone"
  description="SEO, local SEO and AI SEO for healthcare, allied health and NDIS providers: discoverability reports, Google Business Profile, structured data and content."
  path="/services"
  ogTitle="Services — Trivarone"
  ogDescription="AI search and discoverability work for healthcare, allied health and NDIS providers. The check is free. The work that follows is listings, wording, content and structured data."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <section class="titleblock">
    <div class="shell">
      <p class="eyebrow">Services</p>
      <h1>Check first. Then fix what is <em>worth fixing</em>.</h1>
      <p class="standfirst">
        Traditional SEO is the foundation and it has not gone away. AI SEO is the layer
        built on top of it. Both start with the same question: when somebody searches for
        what you do, are you there?
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <p class="section-label">Finding out</p>

      <div class="services">
        <div class="service-group">
          <h3>The free discoverability check</h3>
          <p>
            Your practice is searched two ways — by name, and by what it actually does —
            across Google, Google Maps, ChatGPT, Gemini and Perplexity. You are sent what
            came back, what did not, who appeared instead, and the two or three things
            worth doing first. No cost and no obligation.
          </p>
        </div>

        <div class="service-group">
          <h3>The full AI search report</h3>
          <p>
            The longer version. More questions, more systems, and the causes traced rather
            than listed — the listings, the wording, the structure of the site, and what a
            practice cannot change at any price. Every report has a section on what not to
            spend money on.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Listings and local search</p>

      <div class="services">
        <div class="service-group">
          <h3>Google Business Profile setup and repair</h3>
          <p>
            Categories chosen against what comparable practices actually use, service
            areas set correctly, description and details corrected, and the name, address
            and phone made identical everywhere they appear. Free to do, and the most
            direct fix available for local discoverability.
          </p>
        </div>

        <div class="service-group">
          <h3>Bing Places for Business</h3>
          <p>
            Bing is Microsoft's search engine — the equivalent of Google Search, built into
            Windows and the Edge browser. Bing Places is its version of a Google Business
            Profile, and it is free in the same way.
          </p>
          <p>
            It matters more than its share of searches suggests, because ChatGPT's web
            search runs on Bing's index rather than Google's, and Microsoft Copilot runs on
            Bing as well. A practice ranking first on Google can be entirely absent from a
            ChatGPT answer simply because nobody has ever claimed the Bing listing. It takes
            about an hour, and almost nobody has done it.
          </p>
        </div>

        <div class="service-group">
          <h3>Structured data</h3>
          <p>
            The markup that tells a search or AI system what a page is about rather than
            leaving it to guess — practice details, services, locations and questions,
            written into the page itself.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Words and content</p>

      <div class="services">
        <div class="service-group">
          <h3>Homepage and website wording</h3>
          <p>
            Not a rebuild. The sentences. What you do, where you do it, who for, and why
            you are credible, in plain words and before anyone has to scroll. Usually a
            small change, and usually the one that matters most after the listings.
          </p>
        </div>

        <div class="service-group">
          <h3>Articles that answer real questions</h3>
          <p>
            Writing that answers what people ask before they call — how long something
            takes, whether a referral is needed, what a first appointment involves.
            Supplied ready to publish, with the structured data included.
          </p>
        </div>

        <div class="service-group">
          <h3>Content repurposing</h3>
          <p>
            Material you already have — a talk, a recorded conversation, an article, a set
            of patient questions — turned into posts and captions across your channels on
            a fixed delivery day. Writing and repurposing only. Not filming, video editing
            or graphic production.
          </p>
        </div>

        <div class="service-group">
          <h3>Website builds</h3>
          <p>
            Occasional work, usually where a relationship already exists or where the
            existing site is the thing standing in the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Ongoing</p>

      <div class="services">
        <div class="service-group">
          <h3>Monthly retainer</h3>
          <p>
            For practices that want the work continued rather than finished. Listings kept
            current, new questions answered as they come up, and content produced on a fixed
            day each month. The search is re-run each quarter so you can see what moved and
            what did not, which is the reporting, not the reason for the retainer.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--navy">
    <div class="shell">
      <p class="section-label">On pricing</p>
      <h2>Quoted after the conversation, not before it.</h2>
      <div class="prose">
        <p class="lede">
          What a piece of work costs depends on what it needs to cover. A short
          conversation is enough to scope it, and the quote follows in writing. There is
          no obligation attached to asking.
        </p>
      </div>
      <div class="actions">
        <a class="btn" href="/contact">Ask about a piece of work</a>
      </div>
    </div>
  </section>
</Base>
