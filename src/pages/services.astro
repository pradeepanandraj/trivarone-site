---
import Base from '../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Services — Trivarone",
  "url": "https://www.trivarone.com/services/",
  "isPartOf": {
    "@id": "https://www.trivarone.com/#organisation"
  },
  "about": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Service",
          "name": "Free discoverability check",
          "description": "Your practice searched two ways, by name and by what it actually does, across Google's ordinary results, Google's AI Mode, ChatGPT, Gemini and Perplexity, along with where it appears in Google Maps, with what came back and what is worth doing first. No cost."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Service",
          "name": "AI search and discoverability report",
          "description": "The longer version, with causes traced rather than listed, including what a practice cannot change at any price."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Service",
          "name": "Google Business Profile setup and repair",
          "description": "Categories, service areas, description and details corrected, and name, address and phone made identical everywhere they appear."
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "Service",
          "name": "Bing Places for Business setup",
          "description": "Bing Places for Business is Microsoft's version of a Google Business Profile. Microsoft Copilot is built on Bing, and Bing is one of the places AI assistants look for information about a business."
        }
      },
      {
        "@type": "ListItem",
        "position": 5,
        "item": {
          "@type": "Service",
          "name": "Structured data and schema markup",
          "description": "Markup that tells a search or AI system what a page is about rather than leaving it to guess."
        }
      },
      {
        "@type": "ListItem",
        "position": 6,
        "item": {
          "@type": "Service",
          "name": "Homepage and website wording",
          "description": "Your existing site, with the words rewritten: what you do, where you do it, who for, and why you are credible, in plain words and before anyone has to scroll."
        }
      },
      {
        "@type": "ListItem",
        "position": 7,
        "item": {
          "@type": "Service",
          "name": "Articles that answer real questions",
          "description": "Writing that answers what people ask before they call: how long something takes, whether a referral is needed, what a first appointment involves. Supplied ready to publish."
        }
      },
      {
        "@type": "ListItem",
        "position": 8,
        "item": {
          "@type": "Service",
          "name": "Content repurposing",
          "description": "Material you already have, such as a talk, an article, a set of patient questions or a short video filmed on your phone, turned into posts, captions and short clips on a fixed delivery day. Filming and professional video production are not included."
        }
      },
      {
        "@type": "ListItem",
        "position": 9,
        "item": {
          "@type": "Service",
          "name": "Website build",
          "description": "Taken on occasionally, where a relationship already exists or the existing site is the thing standing in the way."
        }
      },
      {
        "@type": "ListItem",
        "position": 10,
        "item": {
          "@type": "Service",
          "name": "Monthly retainer",
          "description": "Listings kept current, new questions answered, and content produced on a fixed day each month, with the search re-run quarterly."
        }
      }
    ]
  }
};
---
<Base
  title="Services — AI Search for Health Practices — Trivarone"
  description="SEO, local SEO and AI SEO for doctors, dentists and allied health practices: discoverability reports, Google Business Profile, structured data and content."
  path="/services"
  ogTitle="Services — Trivarone"
  ogDescription="AI search and discoverability work for doctors, dentists and allied health practices. The check is free. The work that follows is listings, wording, content and structured data."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <section class="titleblock">
    <div class="shell">
      <p class="eyebrow">Services</p>
      <h1>Check first. Then fix what is <em>worth fixing</em>.</h1>
      <p class="standfirst">
        Trivarone works with doctors, dentists and allied health practices in Australia.
        Every piece of work starts with one question: when somebody searches for what you
        do, are you there?
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <p class="section-label">Finding out</p>

      <div class="services">
        <div class="service-group">
          <h3>The free discoverability check</h3>
          <p>
            Your practice is searched two ways: by name, and by what it does. The search
            covers Google's ordinary results, Google's AI Mode, ChatGPT, Gemini and
            Perplexity, along with where you appear in Google Maps. You are sent what
            came back, what did not, who appeared instead, and the two or three things
            worth doing first. No cost and no obligation.
          </p>
        </div>

        <div class="service-group">
          <h3>The full AI search report</h3>
          <p>
            The longer version. More questions, more places checked, and the causes
            traced: the listings, the wording, the structure of the site, and what a
            practice cannot change at any price. The full report has a section on what not
            to spend money on.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Listings and local search</p>

      <div class="services">
        <div class="service-group">
          <h3>Google Business Profile setup and repair</h3>
          <p>
            Your listing on Google and Google Maps. The categories, service areas,
            description and details are corrected, and the name, address and phone number
            are made identical everywhere they appear. Google does not charge for the
            listing.
          </p>
        </div>

        <div class="service-group">
          <h3>Bing Places for Business</h3>
          <p>
            Bing is Microsoft's search engine, and Bing Places is its version of a Google
            Business Profile. Microsoft does not charge for it either.
          </p>
          <p>
            It matters because Microsoft Copilot is built on Bing, and Bing is one of the
            places AI assistants look for information about a business. Claiming it is a
            short task. Microsoft then reviews the listing before it appears.
          </p>
        </div>

        <div class="service-group">
          <h3>Structured data</h3>
          <p>
            Labels written into a page that tell a search engine or an AI system what the
            page is about: practice details, services, locations and questions. Visitors do
            not see them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Words and content</p>

      <div class="services">
        <div class="service-group">
          <h3>Homepage and website wording</h3>
          <p>
            Your existing site, with the words rewritten: what you do, where you do it,
            who for, and why you are credible, in plain words and before anyone has to
            scroll.
          </p>
        </div>

        <div class="service-group">
          <h3>Articles that answer real questions</h3>
          <p>
            Writing that answers what people ask before they call: how long something
            takes, whether a referral is needed, what a first appointment involves.
            Supplied ready to publish.
          </p>
        </div>

        <div class="service-group">
          <h3>Content repurposing</h3>
          <p>
            Material you already have, such as a talk, an article, a set of patient
            questions or a short video filmed on your phone, turned into posts, captions
            and short clips on a fixed delivery day. Filming and professional video
            production are not included.
          </p>
        </div>

        <div class="service-group">
          <h3>Website builds</h3>
          <p>
            Taken on occasionally, where a relationship already exists or the existing
            site is the thing standing in the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--rule">
    <div class="shell">
      <p class="section-label">Continuing work</p>

      <div class="services">
        <div class="service-group">
          <h3>Monthly retainer</h3>
          <p>
            For practices that want the work continued. Listings kept current, new
            questions answered as they come up, and content produced on a fixed day each
            month. The search is re-run each quarter so you can see what moved and what did
            not.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--navy">
    <div class="shell">
      <p class="section-label">On pricing</p>
      <h2>Quoted after the conversation, not before it.</h2>
      <div class="prose">
        <p class="lede">
          What a piece of work costs depends on what it needs to cover. A short
          conversation is enough to scope it, and the quote follows in writing. Asking
          carries no obligation.
        </p>
      </div>
      <div class="actions">
        <a class="btn" href="/contact/">Ask about a piece of work</a>
      </div>
    </div>
  </section>
</Base>
