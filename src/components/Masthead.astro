---
const links = [
  { href: '/', label: 'Overview' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/articles/', label: 'Articles' },
  { href: '/faq/', label: 'Questions' },
  { href: '/contact/', label: 'Contact' },
];

// Normalise both sides so /articles/some-slug marks the Articles tab, and a
// trailing slash on either the URL or the link never changes the match.
const strip = (p: string) => p.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);
const isCurrent = (href: string) => {
  const target = strip(href);
  return target === '/' ? path === '/' : path === target || path.startsWith(target + '/');
};
---
<header class="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="/">
      Trivarone
      <span class="wordmark__tag">AI SEO — healthcare, allied health and NDIS</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
