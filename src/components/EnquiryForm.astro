---
import '../styles/form.css';

// Wraps the Formspree form and its submit handler. check and contact used the
// same 38-line script, differing only in these two element ids.
interface Props {
  formId: string;
  successId: string;
}
const { formId, successId } = Astro.props;
---
<slot />

<script is:inline define:vars={{ formId, successId }}>
(function () {
  var form = document.getElementById(formId);
  var done = document.getElementById(successId);
  if (!form || !done) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    var button = form.querySelector('button[type="submit"]');
    var original = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending...';

    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' }
    })
    .then(function (response) {
      if (response.ok) {
        form.reset();
        form.hidden = true;
        done.hidden = false;
        done.setAttribute('tabindex', '-1');
        done.focus();
      } else {
        button.disabled = false;
        button.textContent = original;
        alert('Something went wrong. Please email pradeep@trivarone.com directly.');
      }
    })
    .catch(function () {
      button.disabled = false;
      button.textContent = original;
      alert('Something went wrong. Please email pradeep@trivarone.com directly.');
    });
  });
})();
</script>

